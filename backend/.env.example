# ─────────────────────────────────────────────────────
# Trámite Claro — Variables de entorno
# Copia este archivo como .env y rellena cada valor.
# NUNCA commitees el archivo .env real.
# ─────────────────────────────────────────────────────

# ── watsonx.ai ──────────────────────────────────────
# Credenciales del proyecto en IBM watsonx.ai
WATSONX_API_KEY=       # API key de la instancia (API_PROJECT)
WATSONX_URL=           # URL del servicio, ej. https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=    # ID del proyecto en watsonx.ai (PROJECT_ID)
WATSONX_MODEL_ID=ibm/granite-4-h-small   # Modelo para MVP

# ── Watson Speech to Text ────────────────────────────
# Instancia independiente de Watson STT
STT_API_KEY=           # API key de la instancia Watson STT
STT_URL=               # URL del servicio Watson STT

# ── Watson Text to Speech ────────────────────────────
# Instancia independiente de Watson TTS
TTS_API_KEY=           # API key de la instancia Watson TTS
TTS_URL=               # URL del servicio Watson TTS

# ── Watson Machine Learning (módulo LSM experimental) ─
# Deployment ID del modelo de Lenguaje de Señas Mexicana en WML
WML_LSM_DEPLOYMENT_ID= # ID del deployment en Watson Machine Learning
